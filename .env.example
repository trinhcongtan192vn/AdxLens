# AdxLens — biến môi trường. Copy thành .env.local (hoặc chạy `pnpm env:init`).
# KHÔNG commit .env.local. KHÔNG bao giờ đặt secrets production vào máy dev (CLAUDE.md quy tắc 9).

# --- Chung ---
APP_ENV=local
APP_URL=http://localhost:3000
PUBLIC_REPORT_URL=http://localhost:3000/r
LOG_LEVEL=info
# Chuỗi ngẫu nhiên ≥ 32 ký tự: ký URL nội bộ (trang in PDF), cookie. `pnpm env:init` tự sinh.
INTERNAL_SIGNING_SECRET=

# --- Database & queue (Supabase local + Docker Compose) ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://127.0.0.1:6379

# --- Supabase (lấy từ `pnpm exec supabase status --workdir infra`) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Meta Marketing API (chỉ app ở chế độ phát triển) ---
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v24.0
# 1 = dùng dữ liệu Meta giả (không cần app Meta) để chạy thử toàn luồng ở local.
META_MOCK=1

# --- Cửa hàng / analytics (ADR-0029). Hướng dẫn tạo app: docs/runbooks/store-connectors.md ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-07
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_HOST=https://partner.shopeemobile.com
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SERVICE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 1 = Shopify / GA4 giả để chạy thử luồng kết nối ở local.
STORE_MOCK=1

# --- Mã hóa token Meta: 32 byte base64. `pnpm env:init` tự sinh. ---
TOKEN_ENC_KEY_V1=
TOKEN_ENC_KEY_V2=

# --- LLM (tùy chọn; không có thì dùng tóm tắt mẫu) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Email: local đi qua Mailpit của Supabase (http://127.0.0.1:54324) ---
EMAIL_FROM=AdxLens <no-reply@adxlens.local>
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
# Staging/production: SMTP relay Resend (smtp.resend.com, user "resend", pass = API key) — ADR-0004
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# --- Thanh toán (chỉ khóa test) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- Dev công khai: team test qua domain (Cloudflare Tunnel) — docs/runbooks/dev-public.md ---
# Để trống PUBLIC_DEV_APP_URL = chỉ chạy localhost. Có giá trị → Mo-AdxLens.cmd bắt buộc PM_PASSWORD riêng + SMTP thật
# (Resend ở mục Email), cấu hình Supabase Auth theo domain, link logo / PDF qua PUBLIC_DEV_SUPABASE_URL.
PUBLIC_DEV_APP_URL=
PUBLIC_DEV_SUPABASE_URL=
# Tài khoản PM (superadmin) do Mo-AdxLens.cmd tạo. Trống = pm@adxlens.local / mật khẩu mặc định (chỉ localhost).
PM_EMAIL=
PM_PASSWORD=
# Địa chỉ công khai của Supabase cho link logo / PDF (script tự đặt ở chế độ dev công khai).
STORAGE_PUBLIC_URL=

# --- P2: act_ID tài khoản Meta TEST được phép chạy test tích hợp ghi, cách nhau dấu phẩy ---
EXECUTION_ALLOWED_TEST_ACCOUNTS=

# --- Quan sát (tùy chọn) ---
SENTRY_DSN=
POSTHOG_KEY=
# P2 test tích hợp lớp ghi (chỉ staging, tài khoản Meta TEST): pnpm execution:check -- <ad_id> <adset_id>
META_WRITE_TEST_ACCOUNTS=
META_TEST_WRITE_TOKEN=
# Kênh báo đội cho sự cố P1/P2 (email nội bộ, Slack incoming webhook) — để trống ở local
OPS_ALERT_EMAILS=
OPS_SLACK_WEBHOOK_URL=
