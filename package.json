{
  "name": "adxlens",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "env:init": "node scripts/env-init.mjs",
    "seed:staff": "tsx scripts/seed-staff.ts",
    "e4:report": "tsx scripts/e4-report.ts",
    "job:trigger": "pnpm --filter @adxlens/worker exec tsx src/cli/trigger.ts",
    "execution:check": "pnpm --filter @adxlens/worker exec tsx src/cli/execution-check.ts",
    "killswitch": "pnpm --filter @adxlens/worker exec tsx src/cli/killswitch.ts",
    "rules:simulate": "pnpm --filter @adxlens/worker exec tsx src/cli/rules-simulate.ts",
    "smoke": "pnpm --filter @adxlens/worker exec tsx src/cli/smoke.ts",
    "build": "turbo run build",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @adxlens/web test:e2e",
    "db:generate": "pnpm --filter @adxlens/db generate",
    "db:migrate": "pnpm --filter @adxlens/db migrate",
    "db:check": "pnpm --filter @adxlens/db check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@adxlens/core": "workspace:*",
    "@adxlens/db": "workspace:*",
    "@adxlens/jobs": "workspace:*",
    "@adxlens/meta-client": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.5",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "server-only": "^0.0.1",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase"
    ]
  }
}
